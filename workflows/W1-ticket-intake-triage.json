    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"hardware\",\n        \"access\",\n        \"software\",\n        \"network\",\n        \"onboarding\",\n        \"other\"\n      ],\n      \"description\": \"Catégorie du ticket\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"P1\",\n        \"P2\",\n        \"P3\",\n        \"P4\"\n      ],\n      \"description\": \"Priorité, P1 = critique\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1,\n      \"description\": \"Certitude du classement\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"maxLength\": 280,\n      \"description\": \"Résumé en français\"\n    },\n    \"required_skill\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"hardware\",\n        \"access\",\n        \"software\",\n        \"network\",\n        \"onboarding\",\n        \"other\"\n      ],\n      \"description\": \"Compétence technicien requise\"\n    },\n    \"needs_human_review\": {\n      \"type\": \"boolean\",\n      \"description\": \"Reprise humaine nécessaire\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"priority\",\n    \"confidence\",\n    \"summary\",\n    \"required_skill\",\n    \"needs_human_review\"\n  ],\n  \"additionalProperties\": false\n}"
      },
