# The n8n encryption key lives in ./n8n_encryption_key.txt (git-ignored), e.g.:
#   openssl rand -hex 32 > n8n_encryption_key.txt

BASEROW_EXTERNAL_PORT=3000
BASEROW_PUBLIC_URL=http://localhost:3000

N8N_EXTERNAL_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

GENERIC_TIMEZONE=Europe/Paris
MAILPIT_EXTERNAL_PORT=8025

# Helpdesk business settings (read in workflows via $env)
HELPDESK_REFERENCE_PREFIX=TCK
HELPDESK_SENDER_EMAIL=helpdesk@northwind.local
HELPDESK_ADMIN_EMAIL=it-admin@northwind.local
HELPDESK_AI_CONFIDENCE_THRESHOLD=0.6
HELPDESK_FALLBACK_CATEGORY=other
HELPDESK_FALLBACK_PRIORITY=P3
HELPDESK_MANUAL_REVIEW_TAG=manual_review
HELPDESK_SLA_HOURS_P1=4
HELPDESK_SLA_HOURS_P2=8
HELPDESK_SLA_HOURS_P3=24
HELPDESK_SLA_HOURS_P4=72
HELPDESK_TICKET_STATUS_NEW=new
HELPDESK_TICKET_STATUS_LATE=late
HELPDESK_SLA_WARNING_HOURS=1
HELPDESK_AUDIT_ACTION_TRIAGED=triaged
HELPDESK_AUDIT_ACTION_AI_ERROR=ai_error
HELPDESK_AUDIT_ACTION_SLA_REMINDER=sla_reminder
HELPDESK_AUDIT_OUTCOME_SUCCESS=success
HELPDESK_AUDIT_OUTCOME_FAILURE=failure

# Baserow database token used by seed/seed.py (Settings > Database tokens)
BASEROW_URL=http://localhost:3000
BASEROW_TOKEN=
